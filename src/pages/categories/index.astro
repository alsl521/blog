---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryTree } from "@/utils/content-utils";

const categories = await getCategoryTree();
const totalPosts = categories.reduce((sum, category) => sum + category.total, 0);
---

<MainGridLayout title={i18n(I18nKey.categories)}>
    <!-- 页面标题 -->
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.categories)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allCategories)} · {totalPosts} {i18n(I18nKey.postsCount)}
        </p>
    </div>

    <!-- 分类卡片列表：有子分类的展示为阶梯树 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
        {
            categories.map((category, index) =>
                category.children.length === 0 ? (
                    <a
                        href={category.url}
                        class="card-base p-6 flex items-center gap-4 group onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
                    >
                        <div class="shrink-0 w-14 h-14 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors">
                            <Icon
                                name="material-symbols:folder-open"
                                class="text-3xl text-(--primary)"
                            />
                        </div>
                        <div class="flex-1 min-w-0">
                            <h2 class="text-lg font-bold text-90 truncate group-hover:text-(--primary) transition-colors" title={category.name}>
                                {category.name}
                            </h2>
                            <p class="text-sm text-30 mt-1 group-hover:text-(--primary)/60 transition-colors">
                                {category.total} {i18n(I18nKey.postsCount)}
                            </p>
                        </div>
                        <div class="shrink-0">
                            <Icon
                                name="material-symbols:chevron-right-rounded"
                                class="text-2xl text-30 group-hover:text-(--primary) transition-colors "
                            />
                        </div>
                    </a>
                ) : (
                    <div
                        class="card-base p-6 onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
                    >
                        <a
                            href={category.url}
                            class="group flex items-center gap-4"
                            aria-label={`View all posts in the ${category.name} category`}
                        >
                            <div class="shrink-0 w-14 h-14 rounded-full bg-(--primary)/10 group-hover:bg-(--primary)/20 flex items-center justify-center transition-colors">
                                <Icon
                                    name="material-symbols:folder-open"
                                    class="text-3xl text-(--primary)"
                                />
                            </div>
                            <div class="flex-1 min-w-0">
                                <h2 class="text-lg font-bold text-90 truncate group-hover:text-(--primary) transition-colors" title={category.name}>
                                    {category.name}
                                </h2>
                                <p class="text-sm text-30 mt-1 group-hover:text-(--primary)/60 transition-colors">
                                    {category.total} {i18n(I18nKey.postsCount)}
                                </p>
                            </div>
                            <div class="shrink-0">
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="text-2xl text-30 group-hover:text-(--primary) transition-colors"
                                />
                            </div>
                        </a>
                        <div class="mt-4 ml-7 border-l border-dashed border-black/10 dark:border-white/15 pl-2 flex flex-col">
                            {category.children.map((child) => (
                                <a
                                    href={child.url}
                                    class="group flex items-center gap-2 rounded-lg px-2 py-1.5 transition-colors hover:bg-(--btn-plain-bg-hover)"
                                    aria-label={`View all posts in the ${child.fullPath} category`}
                                >
                                    <Icon
                                        name="material-symbols:subdirectory-arrow-right-rounded"
                                        class="text-base text-30 group-hover:text-(--primary) transition-colors"
                                    />
                                    <span class="flex-1 min-w-0 truncate text-sm font-medium text-75 group-hover:text-(--primary) transition-colors">
                                        {child.name}
                                    </span>
                                    <span class="shrink-0 px-2 py-0.5 rounded-md text-xs font-bold
                                                 bg-[oklch(0.95_0.025_var(--hue))] dark:bg-[oklch(0.25_0.025_var(--hue))]
                                                 text-(--primary) transition-colors">
                                        {child.count}
                                    </span>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            )
        }
    </div>

    <!-- 空状态 -->
    {
        categories.length === 0 && (
            <div class="card-base px-8 py-12 text-center">
                <Icon
                    name="material-symbols:folder-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }
</MainGridLayout>
