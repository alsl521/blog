---
import ButtonLink from "@/components/common/ButtonLink.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getCategoryTree } from "@/utils/content-utils";

const categories = await getCategoryTree();

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const collapseThreshold = widgetConfig?.specificConfig?.collapseThreshold;
const showTitle = widgetConfig?.showTitle !== false;
const isCollapsed = collapseThreshold
	? categories.length > collapseThreshold
	: false;
---

<WidgetLayout name={i18n(I18nKey.categories)} showTitle={showTitle} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    {categories.map((category) =>
        category.children.length === 0 ? (
            <ButtonLink
                url={category.url}
                badge={String(category.total)}
                label={`View all posts in the ${category.name.trim()} category`}
            >
                {category.name.trim()}
            </ButtonLink>
        ) : (
            <div class="mb-1">
                <ButtonLink
                    url={category.url}
                    badge={String(category.total)}
                    label={`View all posts in the ${category.name.trim()} category`}
                >
                    {category.name.trim()}
                </ButtonLink>
                <div class="ml-4 border-l border-dashed border-black/10 dark:border-white/15 pl-2">
                    {category.children.map((child) => (
                        <ButtonLink
                            url={child.url}
                            badge={String(child.count)}
                            label={`View all posts in the ${child.fullPath} category`}
                        >
                            {child.name}
                        </ButtonLink>
                    ))}
                </div>
            </div>
        )
    )}
</WidgetLayout>
